{
    "name": "@volusion/element-cli",
    "version": "3.5.0",
    "description": "Command line interface for the Volusion Element ecosystem",
    "author": "Volusion, LLC",
    "main": "bin/src/index.js",
    "license": "MIT",
    "homepage": "https://github.com/volusion/element-cli#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/volusion/element-cli.git"
    },
    "private": false,
    "preferGlobal": true,
    "publishConfig": {
        "access": "public"
    },
    "bin": {
        "element": "./bin/src/index.js"
    },
    "resolutions": {
        "**/**/node-gyp": "5.0.0"
    },
    "overrides": {
        "tmp": "0.2.5"
    },
    "dependencies": {
        "axios": "^1.6.8",
        "chalk": "^2.4.1",
        "commander": "^2.15.1",
        "inquirer": "^6.2.0",
        "replace-in-file": "^3.4.0",
        "rimraf": "^2.6.2",
        "uglify-js": "^3.6.0"
    },
    "devDependencies": {
        "@types/inquirer": "0.0.43",
        "@types/jest": "^29.5.12",
        "@types/node": "^11.11.1",
        "@types/nodegit": "^0.24.4",
        "@types/rimraf": "^2.0.2",
        "@types/uglify-js": "^3.0.4",
        "@typescript-eslint/eslint-plugin": "^5.62.0",
        "@typescript-eslint/parser": "^5.62.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^8.10.0",
        "eslint-plugin-prettier": "^4.2.1",
        "husky": "^0.14.3",
        "jest": "^29.7.0",
        "mermaid.cli": "^0.5.1",
        "prettier": "^2.2.1",
        "ts-jest": "^29.2.4",
        "typescript": "^4.9.5"
    },
    "scripts": {
        "audit:ci": "npx audit-ci --high",
        "build": "tsc --pretty",
        "build:watch": "tsc --watch --pretty",
        "compile": "tsc --pretty",
        "compile:watch": "tsc --watch --pretty",
        "doc": "mmdc -i docs/*.mmd",
        "lint": "eslint 'src/**/*.ts'",
        "lint:fix": "eslint 'src/**/*.ts' --fix",
        "prepare": "npm run prepush",
        "prepush": "npm run lint && npm test",
        "watch": "tsc --watch --pretty",
        "test": "npm run build && npm run test:unit",
        "test:cov": "jest --coverage",
        "test:unit": "jest",
        "test:watch": "jest --watch"
    }
}
